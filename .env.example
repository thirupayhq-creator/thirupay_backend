# ==========================================================
# TIRU PAY - Environment Variables
# ==========================================================
# Copy this file to .env and replace placeholder values.
# NEVER commit the real .env file to Git.
# ==========================================================


# ==========================================================
# SERVER
# ==========================================================

NODE_ENV=development
PORT=5000


# ==========================================================
# POSTGRESQL / PRISMA
# ==========================================================

DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/tiru_pay"


# ==========================================================
# JWT AUTHENTICATION
# ==========================================================

JWT_SECRET="replace-with-a-long-random-jwt-secret"


# ==========================================================
# PAYMENT PROVIDER
# ==========================================================

# Supported:
# MOCK     = Local development without Cashfree
# CASHFREE = Cashfree Payment Gateway

PAYMENT_PROVIDER=CASHFREE


# ==========================================================
# CASHFREE PAYMENT GATEWAY
# ==========================================================

# Sandbox:
CASHFREE_ENVIRONMENT=sandbox

# Cashfree App ID / Client ID
CASHFREE_CLIENT_ID=""

# Cashfree Secret Key
CASHFREE_CLIENT_SECRET=""

# Cashfree API version
CASHFREE_API_VERSION="2025-01-01"


# ==========================================================
# CASHFREE WEBHOOK
# ==========================================================

# Cashfree webhook signing secret
CASHFREE_WEBHOOK_SECRET=""

# URL where Cashfree sends webhook events
CASHFREE_WEBHOOK_URL="http://localhost:5000/api/v1/webhooks/payment"

# URL where the customer is redirected after checkout
CASHFREE_RETURN_URL="http://localhost:3000/payment/success?order_id={order_id}"


# ==========================================================
# DEFAULT CUSTOMER
# ==========================================================

# Used only when customer details are not supplied
# by the payment request.

DEFAULT_CUSTOMER_PHONE="9999999999"


# ==========================================================
# SMS PROVIDER
# ==========================================================

# MOCK = Local development
SMS_PROVIDER=MOCK


# ==========================================================
# KYC PROVIDER
# ==========================================================

# MOCK = Local development/testing
KYC_PROVIDER=MOCK


# ==========================================================
# LOGGING
# ==========================================================

LOG_LEVEL=info