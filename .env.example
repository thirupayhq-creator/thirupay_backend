# ==========================================================
# TIRU PAY - Environment Configuration Example
# ==========================================================

# Server
PORT=5000
NODE_ENV=development

# ==========================================================
# PostgreSQL Database Connection
# Replace with your PostgreSQL connection string:
# Local: postgresql://postgres:postgres@localhost:5432/tiru_pay?schema=public
# Cloud (Neon/Supabase/Railway): postgresql://user:password@host/dbname?sslmode=require
# ==========================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tiru_pay?schema=public"

# ==========================================================
# JWT Secret
# ==========================================================
JWT_SECRET="replace-with-a-long-random-jwt-secret-string"

# ==========================================================
# Payment Provider Mode
# CASHFREE = Real Cashfree Gateway
# MOCK     = Local offline mock (for testing without API keys)
# ==========================================================
PAYMENT_PROVIDER="CASHFREE"

# ==========================================================
# Cashfree Configuration
# Environment: 'sandbox' (Test) or 'production' (Live)
# ==========================================================
CASHFREE_ENV="sandbox"

# Cashfree API Credentials (from Cashfree Dashboard -> Developers -> API Keys)
# For Sandbox: Client ID starts with TEST...
# For Production: Live Client ID
CASHFREE_CLIENT_ID=""
CASHFREE_CLIENT_SECRET=""

# Cashfree Partner API Key (optional)
CASHFREE_PARTNER_API_KEY=""

# Cashfree API Version (default: 2023-08-01)
CASHFREE_API_VERSION="2023-08-01"

# Cashfree Webhook Secret (from Cashfree Dashboard -> Developers -> Webhooks)
CASHFREE_WEBHOOK_SECRET=""

# Return URL after customer completes checkout
CASHFREE_RETURN_URL="http://localhost:3000/payment/success?order_id={order_id}"

# Webhook Notify URL
CASHFREE_WEBHOOK_URL="http://localhost:5000/api/v1/webhooks/payment"

# Fallback customer phone
DEFAULT_CUSTOMER_PHONE="9999999999"